# ── Servidor ────────────────────────────────────────────────
PORT=3000
# development habilita `synchronize` (crea/actualiza el esquema automáticamente).
# Nunca usar "production" con synchronize: usa migraciones (npm run migration:run).
NODE_ENV=development

# ── Base de datos MySQL ─────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=my_frist_app

# ── JWT ─────────────────────────────────────────────────────
# ¡Cambia este secreto en producción!
JWT_SECRET=cambia-este-secreto-en-produccion
JWT_EXPIRATION=1h

# ── Usuario administrador por defecto ───────────────────────
# Se crea automáticamente al arrancar la aplicación (ver src/database/seeders/admin.seeder.ts)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=12345678

# ── Mail provider config ───────────────────────
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=
MAIL_PASSWORD=

# ── URL FrontEnd ───────────────────────
FRONTEND_URL=
